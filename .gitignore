__pycache__/
*.pyc
.vscode/
.idea/
~$*
.DS_Store

# git 内部文件，绝不能出现在工作区根目录
FETCH_HEAD

# 防止把输出重定向误写成文件（如 `git status > git`）
/cd
/dir
/git
/main
/images
/status
/log
/diff
/branch
/checkout
/commit

# 生成的数据库与合并结果（可由分片元数据重新生成，体积大）
output/taxa.db
output/images_meta.csv

# 图片入库。
#
# 这里改过一次决定，原因值得记下来：
# 最初把 output/images/ 排除在 git 之外，想让图片只走 Actions artifact 分发。
# 结果每次运行的 runner 都是一次全新 checkout，本地那 626 张图既不在 git 里、
# 也不在任何 artifact 里，于是分片抓完图做一致性校验时必然报「ok 记录指向的
# 图片不存在」，8 个分片全部以 exit 1 收场。
#
# 现在图片随仓库走。反正 README 已说明本项目只在本地离线使用，不做公开分发，
# 加上 iNaturalist 的实际覆盖率有限，全量也不会到 9.4 GB。
# 临时文件与图片压缩产物仍然排除。
output/images/**/*.tmp
*.webp.tmp

# ---------- Android APK 相关 ----------
# 给 APK 用的资产（压缩图 + SQLite）由 scripts/build_assets.py 生成，
# 约 60 MB 且完全可再生，不入库。
/dist_assets/

# Capacitor / Node 工程
/capacitor/node_modules/
/capacitor/android/
/capacitor/android/app/src/main/assets/public/
/capacitor/.gradle/
npm-debug.log*

# www/ 里由 copy-assets.js 放进去的生成资产（bio.db + 压缩图片，约 90 MB）
# 以及从 npm CDN 拉下来的 sql.js 运行时，都不入库，可由脚本重新生成。
# 只有界面源码（index.html / app.js / style.css）需要版本管理。
/capacitor/www/assets/
/capacitor/www/sql-wasm.js
/capacitor/www/sql-wasm.wasm

# Android 构建产物与签名
*.apk
*.aab
*.jks
*.keystore
local.properties

